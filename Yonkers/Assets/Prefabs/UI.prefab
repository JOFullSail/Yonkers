      m_Calls: []
  m_text: "Outside Resources 2\nNature Sound FX by lumino from assetstore.unity.com\r\nHandpainted
    Grass & Ground Textures by Chromisu from assetstore.unity.com\r\n\"Ammo\" by
    Evgenii Nikolskii from assetstore.unity.com\r\n\"Sci Fi Military Case Crate URP\"
    by Kostyantyn Grygoryev from assetstore.unity.com\r\n\"Ammo Box\" by Beatheart
    Creative Studio from assetstore.unity.com\r\n\"3D GUNS | Guns Pack\" by Shanshel
    from assetstore.unity.com\r\n\"First aid jar\" by SIUP from assetstore.unity.com\r\n\"Free
    Sound Effects Pack\" by Olivier Girardot from assetstore.unity.com\r\n\"Free
    Gun Packs\" by PolyOne Studio from assetstore.unity.com\r\n\"Free Quick Effects
    Vol. 1\" by Gabriel Aguiar Prod from assetstore.unity.com\r\nJump Sound - \"Fast
    Swish Sound Effect | Free Download | High Quality\" by \r\nArcane Aesthete from
    youtube.com\r\nDouble Jump Sound - \"Powerfull Whooshes 2\" by Nic3_one from
    freesound.org\r\nClimbing Sound - \"Recording of a Ledge Climb\" by modusmogulus
    from freesound.org\r\n\"Laser Weld\" by freesound_community from pixabay.com\r\n\"Cheesy
    Radio Ballad\" by Lisa Hammer from freemusicarchive.org"
