      m_Calls: []
  m_text: "Outside Resources 1\r\n\"10 Skyboxes Pack : Day - Night\" by Wello Soft
    from assetstore.unity.com \r\n\"Hand Painted Rocks-Road Texture\" by Texture
    Me! from assetstore.unity.com\r\nDash Sound - \"wind_gust_short_sqeeeek\" by
    freesound_community from pixaby\r\nGrass walking Sound - \"running in grass\"
    by freesound_community from pixaby\r\nRock walking Sound - \"Rapid Footsteps
    Upon Gravel\" by freesound_community from pixaby\r\nMetal walking Sound - \"Metal
    Footsteps\" by freesound_community from pixaby\r\nRoyal walking Sound - \"Footsteps
    on Parquet\" by freesound_community from pixaby\nUI elements from Kenny\r\nStage
    music from DOVA SYNDROME\r\nStages;\r\nLevel 1 Yonk Plains:                  
    by \r\nLevel 2 Yonk Factory: Winning Road by \r\nLevel 3 Yonk Hills:                
    by \r\nLevel 4 Yonk Train:                  by \r\nLevel 5 The Wall: Monolith
    Black by \r\nLevel 6 Final Boss:      by \n"
